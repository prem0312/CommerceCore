# =================================================================
# CommerceCore Local Development Environment Configuration
# Copy this file to .env to override defaults for local development
# =================================================================

# Initial Administrator Account Bootstrap
COMMERCECORE_ADMIN_EMAIL=admin@commercecore.io
COMMERCECORE_ADMIN_PASSWORD=change-me-admin-password

# Smoke Test Password for Local Validation
COMMERCECORE_SMOKE_TEST_PASSWORD=change-me-smoke-test-password

# Security & JWT Configuration
# Must be a cryptographically strong random string (minimum 256 bits / 32 characters)
JWT_SECRET=replace-with-a-secure-256-bit-secret-key-for-jwt-signing

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis Cache Configuration
REDIS_PORT=6379

# Apache Kafka Configuration
KAFKA_PORT=9092
